NODE_ENV=production
API_PORT=4000
API_PUBLIC_URL=https://api.mywatchbox.net
API_PREFIX=/api/v1
TRUST_PROXY=true

MONGODB_DATABASE=watchbox
MONGODB_PORT=27017

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PORT=6379

RABBITMQ_USER=watchbox
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DOMAIN_EXCHANGE=watchbox.domain
RABBITMQ_JOB_EXCHANGE=watchbox.jobs
RABBITMQ_DEAD_LETTER_EXCHANGE=watchbox.dead-letter

JWT_CUSTOMER_ACCESS_SECRET=replace-with-32-byte-customer-access-secret
JWT_CUSTOMER_REFRESH_SECRET=replace-with-32-byte-customer-refresh-secret
JWT_ADMIN_ACCESS_SECRET=replace-with-32-byte-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=replace-with-32-byte-admin-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=watchbox-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

ATLAS_SEARCH_INDEX=listings_search
ATLAS_VECTOR_INDEX=listing_embeddings_vector

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://api.mywatchbox.net/api/v1/admin/marketplaces/ebay/callback
EBAY_RUNAME=
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=replace-with-32-to-80-character-token
EBAY_DEFAULT_LOCATION_CITY=New York
EBAY_DEFAULT_LOCATION_STATE=NY
EBAY_DEFAULT_LOCATION_POSTAL_CODE=10001
EBAY_DEFAULT_LOCATION_COUNTRY=US

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ELITE_PRICE_ID=

EMAIL_PROVIDER=local
EMAIL_FROM=no-reply@watchbox.local
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

WEB_APP_URL=http://localhost:3000

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

AI_PROVIDER=local
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_MODEL=gpt-5.6
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_ANALYSIS_TIMEOUT_MS=120000
AI_QUERY_NORMALIZATION_TIMEOUT_MS=10000
EBAY_SEARCH_TIMEOUT_MS=15000

ENCRYPTION_KEY=replace-with-32-byte-encryption-key
