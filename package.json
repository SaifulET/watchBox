{
  "name": "watchbox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-only API and worker for the WatchBox luxury watch marketplace.",
  "type": "module",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "predev": "tsx scripts/ensure-local-env.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/workers/run.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "routes:list": "tsx scripts/list-routes.ts",
    "api:verify": "tsx scripts/verify-apis.ts",
    "api:docs": "tsx scripts/generate-api-reference.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run tests/unit --no-file-parallelism",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "vitest run tests/e2e --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "seed": "tsx scripts/seed.ts all",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:permissions": "tsx scripts/seed-permissions.ts",
    "seed:plans": "tsx scripts/seed-plans.ts",
    "seed:catalogue": "tsx scripts/seed-catalogue.ts",
    "seed:marketplaces": "tsx scripts/seed-marketplaces.ts",
    "mongo:indexes": "tsx scripts/create-indexes.ts",
    "atlas:indexes": "tsx scripts/create-atlas-indexes.ts",
    "marketplace:sync": "tsx scripts/marketplace-sync.ts",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "analytics:backfill": "tsx scripts/backfill-analytics.ts",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^13.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
