NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017/watchbox
MONGODB_DATABASE=watchbox

REDIS_PASSWORD=change-me
RABBITMQ_USER=watchbox
RABBITMQ_PASSWORD=change-me

REDIS_URL=redis://default:${REDIS_PASSWORD}@localhost:6379
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/watchbox
RABBITMQ_DOMAIN_EXCHANGE=watchbox.domain
RABBITMQ_JOB_EXCHANGE=watchbox.jobs
RABBITMQ_DEAD_LETTER_EXCHANGE=watchbox.dead-letter

JWT_CUSTOMER_ACCESS_SECRET=replace-with-32-byte-customer-access-secret
JWT_CUSTOMER_REFRESH_SECRET=replace-with-32-byte-customer-refresh-secret
JWT_ADMIN_ACCESS_SECRET=replace-with-32-byte-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=replace-with-32-byte-admin-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=watchbox-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=watchbox
S3_SECRET_ACCESS_KEY=watchbox-secret

ATLAS_SEARCH_INDEX=listings_search
ATLAS_VECTOR_INDEX=listing_embeddings_vector

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:4000/api/v1/admin/marketplaces/ebay/callback
EBAY_ENVIRONMENT=sandbox

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_PROVIDER=local
EMAIL_FROM=no-reply@watchbox.local
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
WEB_APP_URL=http://localhost:3000

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

AI_PROVIDER=local
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

ENCRYPTION_KEY=replace-with-32-byte-encryption-key
